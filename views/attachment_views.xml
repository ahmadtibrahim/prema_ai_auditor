<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_attachment_list" model="ir.ui.view">
        <field name="name">prema.ai.attachment.list</field>
        <field name="model">prema.ai.attachment</field>
        <field name="arch" type="xml">
            <list string="AI Attachments">
                <field name="original_filename"/>
                <field name="mimetype"/>
                <field name="state" widget="badge"
                       decoration-info="state=='pending'"
                       decoration-warning="state=='extracted'"
                       decoration-success="state=='draft_created'"
                       decoration-danger="state=='error'"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="draft_move_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_attachment_form" model="ir.ui.view">
        <field name="name">prema.ai.attachment.form</field>
        <field name="model">prema.ai.attachment</field>
        <field name="arch" type="xml">
            <form string="AI Attachment">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="original_filename"/>
                            <field name="mimetype"/>
                            <field name="session_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="draft_move_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extracted Data">
                            <field name="extracted_data"/>
                        </page>
                        <page string="Error">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
