<odoo>
    <record id="view_audit_scan_list" model="ir.ui.view">
        <field name="name">prema.audit.scan.list</field>
        <field name="model">prema.audit.scan</field>
        <field name="arch" type="xml">
            <list string="Audit Scans">
                <field name="name"/>
                <field name="create_date"/>
                <field name="state"/>
                <field name="total_issues"/>
                <field name="critical_count"/>
                <field name="high_count"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_audit_scan_form" model="ir.ui.view">
        <field name="name">prema.audit.scan.form</field>
        <field name="model">prema.audit.scan</field>
        <field name="arch" type="xml">
            <form string="Audit Scan">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="total_issues"/>
                            <field name="critical_count"/>
                            <field name="high_count"/>
                        </group>
                        <group>
                            <field name="medium_count"/>
                            <field name="low_count"/>
                            <field name="duration_seconds"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issues">
                            <field name="issue_ids">
                                <list>
                                    <field name="risk" widget="badge"
                                           decoration-danger="risk=='critical'"
                                           decoration-warning="risk=='high'"
                                           decoration-info="risk=='medium'"
                                           decoration-success="risk=='low'"/>
                                    <field name="category"/>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="fix_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
