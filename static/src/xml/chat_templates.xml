<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="prema_ai_auditor.PremaAIChat">
        <div class="o_prema_ai_chat p-3">
            <h3>Prema AI Auditor Chat</h3>
            <textarea t-model="state.input" class="form-control" rows="4" placeholder="Ask audit question..."/>
            <button class="btn btn-primary mt-2" t-on-click="sendMessage" t-att-disabled="state.loading">
                <t t-esc="state.loading ? 'Sending...' : 'Send'"/>
            </button>
            <pre class="mt-3"><t t-esc="state.output"/></pre>
        </div>
    </t>
</templates>
