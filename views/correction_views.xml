<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_correction_list" model="ir.ui.view">
        <field name="name">prema.ai.correction.list</field>
        <field name="model">prema.ai.correction</field>
        <field name="arch" type="xml">
            <list string="AI Corrections">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="context_type"/>
                <field name="lesson"/>
                <field name="tags"/>
                <field name="applied_count"/>
            </list>
        </field>
    </record>

    <record id="view_ai_correction_form" model="ir.ui.view">
        <field name="name">prema.ai.correction.form</field>
        <field name="model">prema.ai.correction</field>
        <field name="arch" type="xml">
            <form string="AI Correction">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="context_type"/>
                            <field name="tags"/>
                            <field name="applied_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lesson">
                            <field name="lesson"/>
                        </page>
                        <page string="AI Suggestion">
                            <field name="ai_suggestion"/>
                        </page>
                        <page string="User Correction">
                            <field name="user_correction"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
