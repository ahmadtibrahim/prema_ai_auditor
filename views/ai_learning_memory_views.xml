<odoo>
    <record id="view_prema_ai_learning_memory_list" model="ir.ui.view">
        <field name="name">prema.ai.learning.memory.list</field>
        <field name="model">prema.ai.learning.memory</field>
        <field name="arch" type="xml">
            <list>
                <field name="vendor_id"/>
                <field name="detected_keywords"/>
                <field name="suggested_account_id"/>
                <field name="corrected_account_id"/>
                <field name="times_corrected"/>
                <field name="confidence_score"/>
            </list>
        </field>
    </record>

    <record id="view_prema_ai_learning_memory_form" model="ir.ui.view">
        <field name="name">prema.ai.learning.memory.form</field>
        <field name="model">prema.ai.learning.memory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="vendor_id"/>
                        <field name="detected_keywords"/>
                        <field name="suggested_account_id"/>
                        <field name="corrected_account_id"/>
                        <field name="analytic_account_id"/>
                        <field name="times_corrected"/>
                        <field name="confidence_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prema_ai_learning_memory" model="ir.actions.act_window">
        <field name="name">AI Learning Memory</field>
        <field name="res_model">prema.ai.learning.memory</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_prema_ai_learning_memory"
              name="AI Learning Memory"
              parent="menu_prema_ai_root"
              action="action_prema_ai_learning_memory"
              sequence="25"/>
</odoo>
