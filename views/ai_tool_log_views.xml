<odoo>

    <!-- LIST VIEW -->
    <record id="view_prema_ai_tool_log_list" model="ir.ui.view">
        <field name="name">prema.ai.tool.log.list</field>
        <field name="model">prema.ai.tool.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_prema_ai_tool_log_form" model="ir.ui.view">
        <field name="name">prema.ai.tool.log.form</field>
        <field name="model">prema.ai.tool.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="create_date" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="tool_name" readonly="1"/>
                        <field name="status"/>
                    </group>
                    <group string="Input">
                        <field name="input_payload" widget="text"/>
                    </group>
                    <group string="Output">
                        <field name="output_payload" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_prema_ai_tool_log" model="ir.actions.act_window">
        <field name="name">AI Tool Logs</field>
        <field name="res_model">prema.ai.tool.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_prema_ai_tool_log"
              name="AI Tool Logs"
              parent="menu_prema_ai_root"
              action="action_prema_ai_tool_log"
              sequence="20"/>

</odoo>