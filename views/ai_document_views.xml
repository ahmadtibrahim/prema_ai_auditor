<odoo>
    <record id="view_prema_ai_document_list" model="ir.ui.view">
        <field name="name">prema.ai.document.list</field>
        <field name="model">prema.ai.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="session_id"/>
                <field name="document_type"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_prema_ai_document_form" model="ir.ui.view">
        <field name="name">prema.ai.document.form</field>
        <field name="model">prema.ai.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="session_id"/>
                        <field name="attachment_id"/>
                        <field name="document_type"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="ai_suggested_action"/>
                        <field name="ai_summary" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prema_ai_document" model="ir.actions.act_window">
        <field name="name">AI Documents</field>
        <field name="res_model">prema.ai.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_prema_ai_document"
              name="AI Documents"
              parent="menu_prema_ai_root"
              action="action_prema_ai_document"
              sequence="15"/>
</odoo>
