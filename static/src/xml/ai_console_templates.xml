<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="prema_ai_auditor.AIConsole">
        <div class="o_ai_console_container">
            <div class="o_ai_chat_area">
                <div class="o_ai_messages">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id or msg.content">
                        <div t-att-class="'o_ai_msg ' + msg.role">
                            <div class="o_ai_msg_content">
                                <t t-esc="msg.content"/>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="o_ai_input_bar">
                    <input type="text" t-model="state.input" placeholder="Type your message..."/>
                    <button t-on-click="sendMessage" class="btn btn-primary">Send</button>
                </div>
            </div>
        </div>
    </t>
</templates>
