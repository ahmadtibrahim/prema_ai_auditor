<odoo>

    <!-- TREE VIEW -->
    <record id="view_ai_tool_log_tree" model="ir.ui.view">
        <field name="name">prema.ai.tool.log.tree</field>
        <field name="model">prema.ai.tool.log</field>
        <field name="arch" type="xml">
            <list string="AI Tool Logs">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_ai_tool_log_form" model="ir.ui.view">
        <field name="name">prema.ai.tool.log.form</field>
        <field name="model">prema.ai.tool.log</field>
        <field name="arch" type="xml">
            <form string="AI Tool Log">

                <header>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"/>

                    <button name="action_execute"
                            type="object"
                            string="Execute"
                            class="btn-success"/>

                    <button name="action_delete_log"
                            type="object"
                            string="Delete"
                            class="btn-danger"/>
                </header>

                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="tool_name"/>
                        <field name="status"/>
                        <field name="input_payload"/>
                        <field name="output_payload"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_ai_tool_logs" model="ir.actions.act_window">
        <field name="name">AI Tool Logs</field>
        <field name="res_model">prema.ai.tool.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>