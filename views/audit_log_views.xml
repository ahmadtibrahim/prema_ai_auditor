<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prema_audit_log_tree" model="ir.ui.view">
        <field name="name">prema.audit.log.tree</field>
        <field name="model">prema.audit.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="rule_name"/>
                <field name="severity"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <field name="status"/>
                <field name="approved_by"/>
                <field name="approved_at"/>
            </list>
        </field>
    </record>

    <record id="view_prema_audit_log_form" model="ir.ui.view">
        <field name="name">prema.audit.log.form</field>
        <field name="model">prema.audit.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="rule_name"/>
                        <field name="severity"/>
                        <field name="model_name"/>
                        <field name="record_id"/>
                        <field name="status"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="explanation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prema_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">prema.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
