<templates xml:space="preserve">

    <t t-name="prema_ai_auditor.AIConsole" owl="1">

        <div class="o_ai_layout">

            <div class="o_ai_sidebar">

                <button type="button"
                        class="btn btn-primary w-100 mb-2"
                        t-on-click="createNewSession">
                    + New Chat
                </button>

                <div class="o_ai_session_list">

                    <t t-if="state.sessions and state.sessions.length">
                        <t t-foreach="state.sessions"
                           t-as="session"
                           t-key="session.id">

                            <div class="o_ai_session_item"
                                 t-att-class="session.id === state.activeSessionId ? 'o_ai_session_item active' : 'o_ai_session_item'"
                                 t-on-click="selectSession(session.id)">

                                <div class="o_ai_session_name">
                                    <t t-esc="session.name"/>
                                </div>

                                <div class="o_ai_session_actions">
                                    <i class="fa fa-pencil"
                                       t-on-click.stop="renameSession(session.id)"/>
                                    <i class="fa fa-trash text-danger"
                                       t-on-click.stop="deleteSession(session.id)"/>
                                </div>

                            </div>

                        </t>
                    </t>

                </div>
            </div>

            <div class="o_ai_chat_area">

                <div class="o_ai_messages" t-ref="messages">

                    <t t-if="state.messages and state.messages.length">
                        <t t-foreach="state.messages"
                           t-as="msg"
                           t-key="msg.id">

                            <div t-att-class="msg.role === 'user' ? 'o_ai_msg user' : 'o_ai_msg assistant'">
                                <div class="o_ai_msg_content">
                                    <t t-esc="msg.content"/>
                                </div>
                            </div>

                        </t>
                    </t>

                </div>

                <div class="o_ai_input_bar">

                    <input type="text"
                           class="form-control"
                           placeholder="Type your message..."
                           t-model="state.input"
                           t-on-keydown="handleKeyDown"/>

                    <button type="button"
                            class="btn btn-primary"
                            t-on-click="sendMessage">
                        Send
                    </button>

                </div>

            </div>

        </div>

    </t>

</templates>