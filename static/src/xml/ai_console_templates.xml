<templates xml:space="preserve">

    <t t-name="prema_ai_auditor.AIConsole">
        <div class="o_ai_layout">

            <!-- LEFT SIDEBAR -->
            <div class="o_ai_sidebar">

                <div class="o_ai_sidebar_header">
                    <button t-on-click="createNewSession"
                            class="btn btn-primary w-100">
                        + New Chat
                    </button>
                </div>

                <div class="o_ai_sessions">
                    <t t-foreach="state.sessions"
                       t-as="sess"
                       t-key="sess.id">

                        <div class="o_ai_session_item"
                             t-att-class="{'active': sess.id === state.activeSessionId}"
                             t-on-click="() => selectSession(sess.id)">

                            <!-- Editable session name -->
                            <input type="text"
                                   t-model="sess.name"
                                   t-on-blur="() => renameSession(sess)"
                                   t-on-click.stop=""
                                   class="o_ai_session_name"/>

                            <!-- Delete icon -->
                            <i class="fa fa-trash o_ai_delete_icon"
                               t-on-click.stop="() => deleteSession(sess.id)"/>

                        </div>

                    </t>
                </div>

            </div>

            <!-- RIGHT CHAT AREA -->
            <div class="o_ai_chat_area">

                <div class="o_ai_messages">
                    <t t-foreach="state.messages"
                       t-as="msg"
                       t-key="msg.id">

                        <div t-att-class="'o_ai_msg ' + msg.role">
                            <div class="o_ai_msg_content">
                                <t t-esc="msg.content"/>
                            </div>
                        </div>

                    </t>
                </div>

                <div class="o_ai_input_bar">
                    <input type="text"
                           t-model="state.input"
                           placeholder="Type your message..."/>

                    <button t-on-click="sendMessage"
                            class="btn btn-primary">
                        Send
                    </button>
                </div>

                <div class="o_ai_doc_zone mt-3 p-3 border rounded"
                     t-on-drop="onDrop"
                     t-on-dragover="onDragOver">
                    <div class="mb-2"><strong>Upload Document</strong></div>
                    <input type="file" t-on-change="onFileSelected"/>
                    <div t-if="state.uploadName" class="mt-2">Selected: <t t-esc="state.uploadName"/></div>
                    <button t-on-click="analyzeDocument" class="btn btn-outline-primary mt-2">Analyze Document</button>
                </div>

                <div t-if="state.parsedDocument" class="o_ai_doc_preview mt-3 p-3 border rounded">
                    <div class="d-flex justify-content-between">
                        <strong>Document Preview</strong>
                        <span class="badge text-bg-info"><t t-esc="state.documentStatus || 'analyzed'"/></span>
                    </div>
                    <div class="mt-2">Vendor: <t t-esc="state.parsedDocument.vendor_name"/></div>
                    <div>Date: <t t-esc="state.parsedDocument.bill_date"/></div>
                    <div>Total: <t t-esc="state.parsedDocument.total_amount"/></div>
                    <div class="mt-2"><strong>Suggested Action</strong></div>
                    <div><t t-esc="state.parsedDocument.suggested_action"/></div>
                    <button t-on-click="createDraftBill" class="btn btn-success mt-2">Create Draft Bill</button>
                </div>

            </div>

        </div>
    </t>

</templates>
