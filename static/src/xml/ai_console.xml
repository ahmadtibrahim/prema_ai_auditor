<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="prema_ai_auditor.AiConsole">
<div class="prema-ai-console">

    <!-- Header -->
    <div class="prema-ai-header">
        <span style="font-size:22px">🤖</span>
        <strong style="font-size:15px">Prema AI</strong>
        <span class="badge">CEO ASSISTANT</span>
        <span class="status">Odoo 18 Enterprise · PremaFirm</span>
    </div>

    <!-- Messages -->
    <div class="prema-messages" t-ref="msgContainer">

        <t t-foreach="state.messages" t-as="msg" t-key="msg.key">

            <!-- Plain text message -->
            <div t-if="msg.type === 'msg'" t-attf-class="msg #{msg.role}">
                <t t-esc="msg.content"/>
            </div>

            <!-- Task preview card -->
            <div t-if="msg.type === 'task'"
                 t-attf-class="task-card #{msg.state}">
                <h5>
                    <t t-if="msg.state === 'done'">✅ Completed</t>
                    <t t-elif="msg.state === 'failed'">❌ Failed</t>
                    <t t-elif="msg.state === 'rejected'">🚫 Rejected</t>
                    <t t-elif="msg.state === 'executing'">⏳ Executing...</t>
                    <t t-else="">📋 Action Preview — Awaiting Your Approval</t>
                </h5>

                <div t-raw="msg.preview_html"/>

                <!-- Result summary -->
                <div t-if="msg.result_summary" style="margin-top:8px;font-size:13px;color:#374151">
                    <t t-esc="msg.result_summary"/>
                </div>

                <!-- Approve / Reject buttons -->
                <div t-if="msg.state === 'pending'" class="task-actions">
                    <button class="btn-approve" t-on-click="() => this.approveTask(msg)">
                        ✅ Approve
                    </button>
                    <button class="btn-reject" t-on-click="() => this.rejectTask(msg)">
                        ❌ Reject
                    </button>
                </div>

                <!-- Link to created record -->
                <a t-if="msg.state === 'done' and msg.result_url"
                   t-att-href="msg.result_url" target="_blank"
                   class="task-result-link">→ View created record</a>
            </div>

        </t>

        <!-- Typing dots -->
        <div t-if="state.loading" class="typing-indicator">
            <span/><span/><span/>
        </div>

    </div>

    <!-- Input -->
    <div class="prema-input-area">

        <!-- Attachment badges -->
        <div t-if="state.attachments.length" class="attachments-bar">
            <t t-foreach="state.attachments" t-as="att" t-key="att.id">
                <span class="att-badge">
                    📎 <t t-esc="att.name"/>
                    <span class="rm" t-on-click="() => this.removeAtt(att)">✕</span>
                </span>
            </t>
        </div>

        <div class="input-row">
            <button class="btn-upload" t-on-click="openFilePicker" title="Upload document / invoice">📎</button>
            <input type="file" t-ref="fileInput" style="display:none"
                   accept=".pdf,.png,.jpg,.jpeg,.gif,.tiff"
                   multiple="multiple"
                   t-on-change="onFileChange"/>
            <textarea t-ref="msgInput"
                      placeholder="Ask Prema AI… e.g. 'find duplicate documents' or 'organize driver files'"
                      t-on-keydown="onKey"
                      rows="1"/>
            <button class="btn-send" t-on-click="send" t-att-disabled="state.loading">
                <t t-if="state.loading">…</t>
                <t t-else="">Send ➤</t>
            </button>
        </div>

    </div>

</div>
</t>

</templates>
