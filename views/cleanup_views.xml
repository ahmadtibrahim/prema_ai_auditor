<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prema_cleanup_plan_tree" model="ir.ui.view">
        <field name="name">prema.cleanup.plan.tree</field>
        <field name="model">prema.cleanup.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="status"/>
                <field name="risk_score"/>
                <field name="generated_by_ai"/>
            </tree>
        </field>
    </record>

    <record id="view_prema_cleanup_plan_form" model="ir.ui.view">
        <field name="name">prema.cleanup.plan.form</field>
        <field name="model">prema.cleanup.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="approve_stage" type="object" string="Approve Stage 1" context="{'stage_number': 1}" invisible="status != 'draft'"/>
                    <button name="approve_stage" type="object" string="Approve Stage 2" context="{'stage_number': 2}" invisible="status != 'stage_1'"/>
                    <button name="execute_plan" type="object" string="Execute Plan" invisible="status != 'stage_2'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,stage_1,stage_2,executing,completed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="generated_by_ai"/>
                        <field name="risk_score"/>
                    </group>
                    <group>
                        <field name="summary"/>
                    </group>
                    <notebook>
                        <page string="Steps">
                            <field name="step_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="action_type"/>
                                    <field name="model_name"/>
                                    <field name="record_id"/>
                                    <field name="severity"/>
                                    <field name="approval_stage"/>
                                    <field name="approved"/>
                                    <field name="executed"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prema_cleanup_plan" model="ir.actions.act_window">
        <field name="name">Cleanup Plans</field>
        <field name="res_model">prema.cleanup.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_prema_cleanup_plans" name="Cleanup Plans" parent="menu_prema_ai_root" action="action_prema_cleanup_plan" groups="prema_ai_auditor.group_prema_ai_auditor"/>
</odoo>
